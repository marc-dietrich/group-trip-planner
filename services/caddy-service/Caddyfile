{
  email {$CADDY_EMAIL}
  admin 0.0.0.0:2019
  auto_https disable_redirects
  servers {
    metrics
  }
}

(app_routes) {
  encode zstd gzip

  @prometheus path /ops/prometheus /ops/prometheus/*
  handle @prometheus {
    basic_auth {
      {$MONITORING_USER} {$MONITORING_PASSWORD_HASH}
    }
    reverse_proxy prometheus:9090
  }

  @grafana path /ops/grafana /ops/grafana/*
  handle @grafana {
    basic_auth {
      {$MONITORING_USER} {$MONITORING_PASSWORD_HASH}
    }
    reverse_proxy grafana:3000 {
      header_up X-Forwarded-Proto {http.request.uri.scheme}
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /oauth/* {
    reverse_proxy oauth-proxy:4180
  }

  handle /oauth2/* {
    uri replace /oauth2/ /oauth/
    reverse_proxy oauth-proxy:4180
  }

  handle /mail/* {
    reverse_proxy contact-service:3002
  }

  @stripe_checkout path /create-checkout-session
  handle @stripe_checkout {
    reverse_proxy stripe-service:3001
  }

  @stripe_webhook path /webhook
  handle @stripe_webhook {
    reverse_proxy stripe-service:3001
  }

  @stripe_success path /success /supporter/thanks /group-trip-planner/success /group-trip-planner/supporter/thanks
  handle @stripe_success {
    reverse_proxy stripe-service:3001
  }

  handle {
    reverse_proxy frontend:80
  }
}

:80 {
  import app_routes
}

https://localhost, https://127.0.0.1 {
  tls internal
  import app_routes
}
