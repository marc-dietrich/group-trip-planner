# General
CADDY_DOMAIN=example.com
CADDY_EMAIL=admin@example.com

# Database
POSTGRES_USER=gtp
POSTGRES_PASSWORD=gtp_pw
POSTGRES_DB=gtp

# OAuth2 Proxy (Google)
OAUTH_CLIENT_ID=your-google-client-id
OAUTH_CLIENT_SECRET=your-google-client-secret
# 32-byte base64 string, e.g. python - <<'PY'
# import secrets, base64
# print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())
# PY
OAUTH_COOKIE_SECRET=replace-with-32-byte-base64
# Upstream backend (internal)
OAUTH_UPSTREAM=http://backend:8000
# Public redirect (served via Caddy)
OAUTH_REDIRECT_URL=https://${CADDY_DOMAIN}/oauth2/callback

# Frontend build-time defaults (same-origin via Caddy)
# API requests in code already start with /api/*, so keep the base at root.
VITE_API_BASE_URL=/
# OAuth URLs in code already append /oauth2/*, so keep the base at root.
VITE_OAUTH_BASE_URL=/
