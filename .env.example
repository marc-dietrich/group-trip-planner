# =============================================================================
# Group Trip Planner — Centralized Environment Configuration
# =============================================================================
#
# Single source of truth for ALL runtime configuration across the monorepo.
# In production, Doppler injects these variables:
#
#   doppler run -- docker compose up
#
# For local development, copy this file:
#
#   cp .env.example .env
#
# Then populate secrets and run:
#
#   source .env && docker compose up
#
# =============================================================================

# start with
# doppler run --project group-trip-planner --config prd -- docker compose up -d 


# ── Domain / Reverse Proxy ───────────────────────────────────────────────────

CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com
MONITORING_USER=monitor
# Generate: caddy hash-password --plaintext 'your-password'
MONITORING_PASSWORD_HASH=

# ── Image Tags / Registry (compose deploys) ──────────────────────────────────

GHCR_OWNER=marc-dietrich
IMAGE_TAG=latest

# ── Database (PostgreSQL) ────────────────────────────────────────────────────

POSTGRES_USER=gtp
POSTGRES_PASSWORD=gtp_pw
POSTGRES_DB=gtp
POSTGRES_HOST_PORT=5433

# Backend uses this URL (async driver for SQLAlchemy).
# In docker-compose, this is composed from POSTGRES_USER/PASSWORD/DB above.
# For local dev against the database container (port 5433):
DATABASE_URL=postgresql+asyncpg://gtp:gtp_pw@localhost:5433/gtp
DATABASE_SSL_REQUIRE=false

# ── Backend Application ──────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8000
APP_NAME="Gruppen-Urlaubsplaner API"
APP_VERSION=0.1.0
DEBUG=true

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256

# Internal webhook secret shared between stripe-service and backend
SUPPORTER_WEBHOOK_SECRET=change-me-supporter-secret
SUPPORTER_BADGE_DURATION_DAYS=183

FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_PATH_PREFIX=/group-trip-planner
ENFORCE_HTTPS=false
INVITE_TOKEN_TTL_DAYS=7

# Voice mock feature flag (set false to disable the mock endpoint)
VOICE_MOCK_ENABLED=true

# CORS — JSON array of allowed origins.
# For production, set to your real domain(s).
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080","http://localhost:4180"]'

# ── Object Storage (Garage / S3-compatible) ──────────────────────────────────

STORAGE_ENABLED=true
STORAGE_S3_ENDPOINT=http://localhost:3900
STORAGE_S3_REGION=garage
STORAGE_S3_ACCESS_KEY=garage-access-key
STORAGE_S3_SECRET_KEY=garage-secret-key
STORAGE_S3_BUCKET=group-trip-images
STORAGE_S3_USE_SSL=false

# ── Image Upload / Processing ────────────────────────────────────────────────

IMAGE_UPLOAD_MAX_INPUT_BYTES=5242880
PROFILE_IMAGE_TARGET_BYTES=102400
PROFILE_IMAGE_WIDTH=512
PROFILE_IMAGE_HEIGHT=512
GROUP_IMAGE_TARGET_BYTES=204800
GROUP_IMAGE_WIDTH=1024
GROUP_IMAGE_HEIGHT=512
PRESIGNED_URL_TTL_SECONDS=300

# ── Postgres Backups ─────────────────────────────────────────────────────────

BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
TZ=Europe/Berlin

BACKUP_DAILY_CRON="0 2 * * *"
BACKUP_WEEKLY_CRON="0 3 * * 0"
BACKUP_MONTHLY_CRON="0 4 1 * *"

BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

BACKUP_RUN_ON_STARTUP=false
BACKUP_REMOTE_MODE=disabled
BACKUP_REMOTE_TIMEOUT_SECONDS=120

# rsync over SSH settings (when BACKUP_REMOTE_MODE=rsync)
REMOTE_RSYNC_HOST=
REMOTE_RSYNC_USER=
REMOTE_RSYNC_PATH=
REMOTE_RSYNC_PORT=22
REMOTE_SSH_KEY_MOUNT=
REMOTE_SSH_KEY_PATH=/run/backup-ssh-key
REMOTE_SSH_STRICT_HOST_KEY_CHECKING=yes

# FTP/FTPS settings (when BACKUP_REMOTE_MODE=ftp)
REMOTE_FTP_HOST=
REMOTE_FTP_PORT=21
REMOTE_FTP_USER=
REMOTE_FTP_PASSWORD=
REMOTE_FTP_PATH=/gtp-backups
REMOTE_FTP_SSL=true
REMOTE_FTP_VERIFY_CERT=true

# ── OAuth2 Proxy (Google) ───────────────────────────────────────────────────

OAUTH_CLIENT_ID=your-google-client-id
OAUTH_CLIENT_SECRET=your-google-client-secret
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH_COOKIE_SECRET=replace-with-32-byte-base64

# Standalone oauth-proxy compose defaults
OAUTH_UPSTREAM=http://backend:8000
OAUTH_REDIRECT_URL=http://localhost:4180/oauth2/callback

# ── Stripe Service ───────────────────────────────────────────────────────────

STRIPE_ALLOWED_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PAYMENT_METHOD_TYPES=card,paypal
STRIPE_CHECKOUT_PRODUCT_TEXT=Donation @ planning.made-simple
CHECKOUT_SUCCESS_URL=http://localhost:3000/group-trip-planner/supporter/thanks
CHECKOUT_CANCEL_URL=http://localhost:3000/group-trip-planner/
APP_BASE_URL=http://localhost:3000/group-trip-planner
SUPPORTER_API_BASE_URL=http://localhost:8000

# ── Contact Service ──────────────────────────────────────────────────────────

CONTACT_ALLOWED_ORIGIN=http://localhost:5173
CONTACT_SUPPORT_EMAIL=kontakt@group-trip-planner.local
CONTACT_LOG_FILE=apps/contact-service/data/requests.log
CONTACT_LOG_MAX_BYTES=10485760

# ── Frontend (Vite) ─────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8000
VITE_OAUTH_BASE_URL=http://localhost:4180
VITE_STRIPE_BASE_URL=http://localhost:3001
VITE_CONTACT_SERVICE_BASE_URL=http://localhost:3002
VITE_BASE_PATH=/group-trip-planner/
VITE_DEV_PORT=3000
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_CONTACT_PROXY_TARGET=http://localhost:3002

# Build / test vars
CUSTOM_DOMAIN=false
GITHUB_PAGES=false
VITE_BUILD_COMMIT=
VITE_BUILD_LABEL=
BASE_URL=http://localhost:3000

# ── Garage Storage (local dev only) ─────────────────────────────────────────

GARAGE_ACCESS_KEY_ID=garage-access-key
GARAGE_SECRET_ACCESS_KEY=garage-secret-key
GARAGE_RPC_SECRET=8f1f3df6b3d8a03bc6d4e4295f2f7fd4d709f8e9319a43a2e1b7f6dd4c5b9e0a
GARAGE_ADMIN_TOKEN=2bb8a4e61b9d44e3a8e9f7d5c1a603af2d7e4b6c9f1083a5d4e7b1c2f6a9d8e0
GARAGE_S3_REGION=garage
GARAGE_S3_ROOT_DOMAIN=.s3.localhost

# ── Audio Service (optional) ────────────────────────────────────────────────

WHISPER_MODEL=tiny
NLP_MODEL=google/flan-t5-small

# ── Cloudflare Tunnel (production only) ─────────────────────────────────────

# CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000
