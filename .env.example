# ── Domain & TLS ──────────────────────────────────────────────
CADDY_DOMAIN=planning.made-simple.online
CADDY_EMAIL=you@example.com

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_USER=gtp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gtp

# ── Postgres Backups (Encrypted + Compressed) ────────────────
# Required: strong passphrase used for AES256 GPG symmetric encryption.
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase

# Schedules (cron syntax, container timezone from TZ)
BACKUP_DAILY_CRON=0 2 * * *
BACKUP_WEEKLY_CRON=0 3 * * 0
BACKUP_MONTHLY_CRON=0 4 1 * *

# Retention count per bucket
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

# Optional: run one backup when backup container starts
BACKUP_RUN_ON_STARTUP=false

# Offsite mirror mode: disabled | rsync | ftp
BACKUP_REMOTE_MODE=disabled
BACKUP_REMOTE_TIMEOUT_SECONDS=120

# rsync over SSH settings (for NAS/server)
REMOTE_RSYNC_HOST=
REMOTE_RSYNC_USER=
REMOTE_RSYNC_PATH=
REMOTE_RSYNC_PORT=22
# Host path to private key, mounted into backup container as /run/backup-ssh-key
REMOTE_SSH_KEY_MOUNT=
REMOTE_SSH_KEY_PATH=/run/backup-ssh-key
REMOTE_SSH_STRICT_HOST_KEY_CHECKING=yes

# FTP/FTPS settings
REMOTE_FTP_HOST=
REMOTE_FTP_PORT=21
REMOTE_FTP_USER=
REMOTE_FTP_PASSWORD=
REMOTE_FTP_PATH=/gtp-backups
REMOTE_FTP_SSL=true
REMOTE_FTP_VERIFY_CERT=true

# ── Backend ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-secure-random-string
DEBUG=false

# ── OAuth2 Proxy (Google) ────────────────────────────────────
OAUTH_CLIENT_ID=your-google-client-id
OAUTH_CLIENT_SECRET=your-google-client-secret
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH_COOKIE_SECRET=replace-with-32-byte-base64

# ── Monitoring ───────────────────────────────────────────────
MONITORING_USER=monitor
# Generate bcrypt: caddy hash-password --plaintext 'your-password'
MONITORING_PASSWORD_HASH='$2a$14$...'

# ── Contact Service (File Logging) ──────────────────────────
CONTACT_ALLOWED_ORIGIN=http://localhost:5173
CONTACT_LOG_FILE=apps/contact-service/data/requests.log
CONTACT_LOG_MAX_BYTES=10485760
