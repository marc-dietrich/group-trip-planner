{
  email {$CADDY_EMAIL}
  admin 0.0.0.0:2019
  servers {
    metrics
  }
  auto_https off
}

:80 {
  encode zstd gzip

  @prometheus path /ops/prometheus /ops/prometheus/*
  handle @prometheus {
    basic_auth {
      {$MONITORING_USER} {$MONITORING_PASSWORD_HASH}
    }
    reverse_proxy prometheus:9090
  }

  @grafana path /ops/grafana /ops/grafana/*
  handle @grafana {
    basic_auth {
      {$MONITORING_USER} {$MONITORING_PASSWORD_HASH}
    }
    reverse_proxy grafana:3000 {
      header_up X-Forwarded-Proto {http.request.uri.scheme}
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /oauth2/* {
    reverse_proxy oauth-proxy:4180
  }

  handle {
    reverse_proxy frontend:80
  }
}
