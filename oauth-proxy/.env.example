# Copy to .env and fill in your Google OAuth credentials
# Generate a 32-byte base64 string for the cookie secret, e.g.:
# python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

OAUTH_CLIENT_ID=your-google-client-id
OAUTH_CLIENT_SECRET=your-google-client-secret
OAUTH_COOKIE_SECRET=replace-with-32-byte-base64

# Where authenticated requests should be sent (backend service)
OAUTH_UPSTREAM=http://backend:8000

# Public callback URL for OAuth2 Proxy
OAUTH_REDIRECT_URL=http://localhost:4180/oauth2/callback
